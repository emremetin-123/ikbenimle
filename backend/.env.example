NODE_ENV=development
PORT=5000
# Nginx-only default. Production Compose supplies 2 for Caddy and Nginx.
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Authentication
# Production uses an HttpOnly opaque session cookie stored in the database.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_WARNING_SECONDS=30
MOOD_ANONYMITY_THRESHOLD=3
# SESSION_COOKIE_NAME=ikbenimle_session

# Database
# PostgreSQL (Docker defaults DB_SERVER to the postgres service name):
DB_TYPE=postgres
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# X_ACCEL_REDIRECT_ENABLED=true
# SCHEDULER_ENABLED=false
# SLOW_QUERY_MS=500
# DB_USER=
# DB_PASSWORD=
# DB_SERVER=
# DB_PORT=5432
# DB_NAME=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=<PEM certificate with escaped newlines>
# DB_POOL_MAX=20
# DB_POOL_IDLE_MS=30000
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_REQUEST_TIMEOUT_MS=30000
# PostgreSQL container initialization. Use the same application database values.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# Migration container credentials. Grant schema modification rights only.
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=

# One-time empty-database administrator bootstrap. Remove the password after use.
ALLOW_INITIAL_ADMIN_BOOTSTRAP=false
# INITIAL_ADMIN_EMPLOYEE_ID=
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_PASSWORD=

# Backup health status mounted read-only by Docker Compose.
# BACKUP_STATUS_FILE=/var/run/ikbenimle-backup/status.json

# Development seed data is disabled by default.
SEED_DEFAULT_USERS=false
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_EMPLOYEE_PASSWORD=
SEED_SAMPLE_DATA=false

# Uploads
# By default uploaded files are stored under backend/uploads.
# Production must use persistent storage and off-site backups.
# Optional Cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Eğitim ilerlemesi varsayılan olarak server heartbeat modeliyle doğrulanır.
# Eski istemci geçişini gözlemlemek için geçici olarak observe kullanılabilir.
TRAINING_PROGRESS_ENFORCEMENT=enforce

# AI
# Keep this value server-side. Never expose it through frontend variables.
# GEMINI_API_KEY=
# GEMINI_MODEL=<provider-supported-model>

# Web Push
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:<corporate-address>

# Background jobs use database leases to prevent duplicate execution.
SCHEDULER_ENABLED=true
# POLYVALENCE_CRON_SECRET=

# Structured logs and protected Prometheus metrics
LOG_LEVEL=info
METRICS_ENABLED=false
# METRICS_TOKEN=<at-least-32-random-characters>
API_RATE_LIMIT_5M=30000
LOGIN_IP_RATE_LIMIT_15M=500

# Machine-to-machine ERP bridge
INTEGRATION_RATE_LIMIT_PER_MINUTE=600
INTEGRATION_BALANCE_STALE_HOURS=36

# Optional default mood reminder
# PUSH_MOOD_REMINDER_TIME=09:00
# PUSH_MOOD_REMINDER_ENABLED=true
# PUSH_MOOD_REMINDER_TITLE=Bugün kendini nasıl hissediyorsun?
# PUSH_MOOD_REMINDER_BODY=Günlük duygu durumunu paylaşmak ister misin?

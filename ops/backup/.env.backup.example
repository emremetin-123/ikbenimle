RESTIC_REPOSITORY=s3:https://s3.example.com/ikbenimle-backups/production
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.example.com
DB_TYPE=postgres
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
DB_SERVER=postgres
DB_PORT=5432
DB_NAME=
# SQLite production only:
# SQLITE_FILENAME=/database/database.sqlite
BACKUP_HEALTHCHECK_URL=
BACKUP_HOST=ikbenimle-production
RESTIC_CHECK_SUBSET=5%
